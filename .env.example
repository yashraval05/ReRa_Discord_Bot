# ============================================
# RERA Discord Bot - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# ----------------------------
# Discord Bot Token
# Get from: https://discord.com/developers/applications
# ----------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ----------------------------
# Google Gemini API Key (FREE tier available)
# Get from: https://aistudio.google.com/app/apikey
# Free tier: 1500 req/day, 15 req/min
# Uses OpenAI-compatible endpoint — no Google SDK needed!
# Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------
# Admin Discord User IDs (comma-separated)
# Right-click your name in Discord -> Copy User ID
# (Enable Developer Mode in Discord settings first)
# ----------------------------
DISCORD_ADMIN_USER_IDS=123456789,987654321

# ----------------------------
# Optional Settings (defaults shown)
# ----------------------------
GEMINI_MODEL=gemini-1.5-flash
TOP_K_RESULTS=5
